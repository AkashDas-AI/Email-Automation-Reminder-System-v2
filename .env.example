# ==============================================================================
# Environment Configuration Template
# Project: Email Automation & Reminder System
# Author: Akash Das
#
# INSTRUCTIONS:
# Copy this file to '.env' and populate your local credentials.
# NEVER commit '.env' or expose real passwords to version control.
# ==============================================================================

# Email delivery mode (true = safe dry-run simulation, false = live SMTP transport)
DRY_RUN=true

# SMTP configuration (Gmail defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Live SMTP recipient allowlist (comma-separated; empty by default for safety)
SMTP_ALLOWED_RECIPIENTS=

# Sender information
EMAIL_FROM=
EMAIL_FROM_NAME=Email Automation Reminder System

# Application settings
TIMEZONE=UTC
